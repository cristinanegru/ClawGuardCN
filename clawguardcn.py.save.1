import subp
rocess
import time

print("ClawGuardCN is waking up...🦅")
print("Monitoring Apache like a dramatic server bodyguard.\n")

def run_command(command):
    return subprocess.getoutput(command)

while True:
    apache_status = run_command("systemctl is-active apache2")

    if  apache_status == "active":
         print("Apache is alive. The web server is behaving...for now.")
    else:
         print("\n APACHE FAILURE DETECTED")
         print("Apache has collapsed like a student during exam week.")
         print("ClawGuardCN is checking the logs and preparing emergency recovery...")


         logs = run_command("tail -n 10 /var/log/apache2/error.log")

         print("\n[ LAST APACHE ERROR LOGS ]")
         print(logs)


         print("\n[CLAWGUARDCN AI ANALYSIS]")
         print("Apache is not running, so the website may be unavailable.")
         print("Possible reasons: service crash, configuration issue, memory pressure, or Apache being dramatic again.")


         print("\n[ RECOVERY ACTION ]")

         restart_result = run_command("sudo systemctl restart  apache2")
         print(restart_result)


         new_status = run_command("systemctl is-active apache2")

         if new_status == "active":
             print("\n HEROIC COMEBACK")
             print("Apache is back online.")
             print("Visitors can continue pretending nothing happened.")

          else:
              print("\n RECOVERY FAILED")
              print("Apache refused to get up.")
              print("Manual investigation required.")

       print("\nNext check in 30 seconds...\n")

       time.sleep(30)
